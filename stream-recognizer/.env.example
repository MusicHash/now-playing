# Redis (required for persistence)
REDIS_URI=redis://127.0.0.1:6379

# HTTP API
HTTP_PORT=3847
CORS_ORIGIN=

# After Chromaprint dedup, try each provider id until one returns a match (default: shazam).
# Allowed ids are defined in src/config.js getAudioRecognitionOrder().
# AUDIO_RECOGNITION_ORDER=shazam

# Shazam (fingerprint via npm shazamio-core WASM, then POST to Shazam AMP — no API key)
# SHAZAM_DISABLED=1           # opt out without changing AUDIO_RECOGNITION_ORDER
# SHAZAM_LANGUAGE=en-US
# SHAZAM_ENDPOINT_COUNTRY=GB
# SHAZAM_DEVICE=iphone
# SHAZAM_TIMEZONE=Europe/London
# SHAZAM_SIGNATURE_GAP_MS=450 # delay between signature segments (rate-limit courtesy)
# SHAZAM_429_RETRY_MS=2500    # pause before one retry after HTTP 429
# SHAZAM_FETCH_TIMEOUT_MS=28000
# SHAZAM_USER_AGENT=          # optional fixed UA; if unset, each request uses a random entry from shazam_user_agents.json
# SHAZAM_DEBUG_RESPONSE=1     # log truncated JSON on miss
# HTTP proxy pool for outbound traffic (comma-separated or JSON array). Round-robin per station tick.
# Same proxy is used for ffmpeg stream capture and Shazam on that tick.
# HTTP_PROXY=http://127.0.0.1:8888
# HTTP_PROXY=http://proxy-a:8080,http://proxy-b:8080
# HTTP_PROXY=["http://proxy-a:8080","http://proxy-b:8080"]

# Optional: copy captured WAVs here when DEBUG_CAPTURE_ENABLED (default 1)
# Filenames: `{stationId}-{tickId}-{label}.wav` (e.g. no-match, detected-empty-…, saved-<provider>-after-shazam-miss).
# DEBUG_CAPTURE_ENABLED=1   # default 1; set 0 to disable
# DEBUG_CAPTURE_DIR=/tmp/stream-recognizer-debug


# Defaults
POLL_INTERVAL_SEC=120
REDIS_KEY_PREFIX=stream-recognizer:v1
PINO_LOG_LEVEL=info

# Binaries (defaults: search PATH). On WSL: apt install ffmpeg libchromaprint-tools
# FPCALC_BIN=/usr/bin/fpcalc
FFMPEG_BIN=/usr/bin/ffmpeg
FPCALC_BIN=/usr/bin/fpcalc

# Timeouts (ms) — avoid hangs on bad streams (e.g. DASH .livx)
# FFMPEG_CAPTURE_TIMEOUT_MS=55000
# FFMPEG_CAPTURE_OVERHEAD_MS=45000
# FFMPEG_DECODE_TIMEOUT_MS=90000
# FPCALC_TIMEOUT_MS=120000

# Audio pipeline
CAPTURE_SECONDS=10
RMS_SILENCE_DB=-45
VAD_SPEECH_RATIO_SKIP=0.72
VAD_ENABLED=1

# Before Chromaprint/APIs: skip dead-air / off-air segments (encoder noise can bypass silence gate)
# PRE_RECOGNITION_EMPTY_CHECK=1
# PRE_RECOGNITION_MIN_PEAK_DB=-42
# PRE_RECOGNITION_MAX_SILENT_FRAME_RATIO=0.94
