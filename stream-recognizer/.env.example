# Redis (required for persistence)
REDIS_URI=redis://127.0.0.1:6379

# HTTP API
HTTP_PORT=3847
CORS_ORIGIN=

# ACRCloud (default first in AUDIO_RECOGNITION_ORDER) — https://console.acrcloud.com/
# EU: identify-eu-west-1.acrcloud.com | US: identify-us-west-2.acrcloud.com (must match project region in console)
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
# ACRCLOUD_SAMPLE_RATE=16000
# ACRCLOUD_WAV_AUTO=1          # let ACR infer format from WAV header (try if no matches)
# ACRCLOUD_DEBUG_RESPONSE=1    # log truncated JSON on every ACR miss (diagnostics)

# After Chromaprint dedup, try each until one returns a match (default: ACRCloud then AcoustID)
# AUDIO_RECOGNITION_ORDER=acrcloud,shazam,acoustid

# Shazam (fingerprint via npm shazamio-core WASM, then POST to Shazam AMP — no API key)
# SHAZAM_DISABLED=1           # opt out without changing AUDIO_RECOGNITION_ORDER
# SHAZAM_LANGUAGE=en-US
# SHAZAM_ENDPOINT_COUNTRY=GB
# SHAZAM_DEVICE=iphone
# SHAZAM_TIMEZONE=Europe/London
# SHAZAM_SIGNATURE_GAP_MS=450 # delay between signature segments (rate-limit courtesy)
# SHAZAM_429_RETRY_MS=2500    # pause before one retry after HTTP 429
# SHAZAM_FETCH_TIMEOUT_MS=28000
# SHAZAM_USER_AGENT=          # optional fixed UA; if unset, each request uses a random entry from shazam_user_agents.json
# SHAZAM_DEBUG_RESPONSE=1     # log truncated JSON on miss
# HTTP_PROXY=http://127.0.0.1:8888

# AcoustID — application client key from https://acoustid.org/new-application (NOT the user key from /api-key)
# Aliases: ACOUSTID_APPLICATION_KEY, ACOUSTID_API_KEY
# ACOUSTID_DEBUG_RESPONSE=1  # log truncated JSON response when no title/artist parsed
# ACOUSTID_DURATION_SPREAD=1   # try round(fpcalc duration) ± N seconds (0–5) when lookup is empty
# ACOUSTID_RETRY_DELAY_MS=350  # pause between duration retries (rate limit courtesy)

ACOUSTID_CLIENT_KEY=

# Optional: when AcoustID returns no match, copy the captured WAV here for inspection
# DEBUG_CAPTURE_DIR=/tmp/stream-recognizer-debug

# Defaults
POLL_INTERVAL_MS=120000
REDIS_KEY_PREFIX=stream-recognizer:v1
PINO_LOG_LEVEL=info

# Binaries (defaults: search PATH). On WSL: apt install ffmpeg libchromaprint-tools
# FPCALC_BIN=/usr/bin/fpcalc
FFMPEG_BIN=/usr/bin/ffmpeg
FPCALC_BIN=/usr/bin/fpcalc

# Timeouts (ms) — avoid hangs on bad streams (e.g. DASH .livx)
# FFMPEG_CAPTURE_TIMEOUT_MS=55000
# FFMPEG_CAPTURE_OVERHEAD_MS=45000
# FFMPEG_DECODE_TIMEOUT_MS=90000
# FPCALC_TIMEOUT_MS=120000

# Audio pipeline
CAPTURE_SECONDS=10
RMS_SILENCE_DB=-45
VAD_SPEECH_RATIO_SKIP=0.72
VAD_ENABLED=1
