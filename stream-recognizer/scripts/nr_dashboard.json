{
  "name": "Stream Recognizer – Operational Dashboard",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Station ticks",
      "widgets": [
        {
          "title": "Tick duration P95 (s)",
          "layout": { "column": 1, "row": 1, "width": 8, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "legend": { "enabled": true },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT percentile(durationMs / 1000, 95) FROM ServerMetric WHERE appName = 'stream-recognizer' AND measurement = 'StreamRecognizerTick' FACET stationID TIMESERIES AUTO LIMIT 50"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Tick error rate (%)",
          "layout": { "column": 9, "row": 1, "width": 4, "height": 3 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT percentage(count(*), WHERE success = 0) AS 'Error %' FROM ServerMetric WHERE appName = 'stream-recognizer' AND measurement = 'StreamRecognizerTick' SINCE 1 hour ago"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Tick outcomes (count)",
          "layout": { "column": 1, "row": 4, "width": 6, "height": 3 },
          "visualization": { "id": "viz.area" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "legend": { "enabled": true },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT count(*) FROM ServerMetric WHERE appName = 'stream-recognizer' AND measurement = 'StreamRecognizerTick' FACET outcome TIMESERIES AUTO LIMIT 30"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Outcomes by station (1h)",
          "layout": { "column": 7, "row": 4, "width": 6, "height": 3 },
          "visualization": { "id": "viz.bar" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT count(*) FROM ServerMetric WHERE appName = 'stream-recognizer' AND measurement = 'StreamRecognizerTick' FACET stationID, outcome SINCE 1 hour ago LIMIT 100"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Avg tick duration by outcome (s)",
          "layout": { "column": 1, "row": 7, "width": 12, "height": 3 },
          "visualization": { "id": "viz.bar" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT average(durationMs / 1000) FROM ServerMetric WHERE appName = 'stream-recognizer' AND measurement = 'StreamRecognizerTick' FACET outcome SINCE 6 hours ago LIMIT 30"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        }
      ]
    },
    {
      "name": "Capture & fingerprint",
      "widgets": [
        {
          "title": "FFmpeg capture latency P95 (s)",
          "layout": { "column": 1, "row": 1, "width": 8, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "legend": { "enabled": true },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT percentile(durationMs / 1000, 95) FROM ServerMetric WHERE appName = 'stream-recognizer' AND measurement = 'StreamRecognizerCapture' AND success = 1 FACET stationID TIMESERIES AUTO LIMIT 50"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Capture failure rate (%)",
          "layout": { "column": 9, "row": 1, "width": 4, "height": 3 },
          "visualization": { "id": "viz.bar" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT percentage(count(*), WHERE success = 0) AS 'Fail %' FROM ServerMetric WHERE appName = 'stream-recognizer' AND measurement = 'StreamRecognizerCapture' FACET stationID SINCE 1 hour ago LIMIT 50"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Capture retry depth (avg attempts)",
          "layout": { "column": 1, "row": 4, "width": 6, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "legend": { "enabled": true },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT average(attempts) FROM ServerMetric WHERE appName = 'stream-recognizer' AND measurement = 'StreamRecognizerCapture' AND success = 1 FACET stationID TIMESERIES AUTO LIMIT 50"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Decode (PCM) latency P95 (s)",
          "layout": { "column": 7, "row": 4, "width": 6, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "legend": { "enabled": true },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT percentile(durationMs / 1000, 95) FROM ServerMetric WHERE appName = 'stream-recognizer' AND measurement = 'StreamRecognizerDecode' AND success = 1 FACET stationID TIMESERIES AUTO LIMIT 50"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Chromaprint fingerprint latency P95 (s)",
          "layout": { "column": 1, "row": 7, "width": 6, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "legend": { "enabled": true },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT percentile(durationMs / 1000, 95) FROM ServerMetric WHERE appName = 'stream-recognizer' AND measurement = 'StreamRecognizerFingerprint' AND success = 1 FACET stationID TIMESERIES AUTO LIMIT 50"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Decode / fingerprint failures (count)",
          "layout": { "column": 7, "row": 7, "width": 6, "height": 3 },
          "visualization": { "id": "viz.area" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "legend": { "enabled": true },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT count(*) FROM ServerMetric WHERE appName = 'stream-recognizer' AND measurement IN ('StreamRecognizerDecode','StreamRecognizerFingerprint') AND success = 0 FACET measurement TIMESERIES AUTO"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        }
      ]
    },
    {
      "name": "Providers",
      "widgets": [
        {
          "title": "Provider call latency P95 (s)",
          "layout": { "column": 1, "row": 1, "width": 8, "height": 3 },
          "visualization": { "id": "viz.line" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "legend": { "enabled": true },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT percentile(durationMs / 1000, 95) FROM ServerMetric WHERE appName = 'stream-recognizer' AND measurement = 'StreamRecognizerProviderCall' FACET provider TIMESERIES AUTO LIMIT 20"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Match rate (%)",
          "layout": { "column": 9, "row": 1, "width": 4, "height": 3 },
          "visualization": { "id": "viz.billboard" },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT percentage(count(*), WHERE matched = 1) AS 'Match %' FROM ServerMetric WHERE appName = 'stream-recognizer' AND measurement = 'StreamRecognizerProviderCall' SINCE 1 hour ago"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Provider call volume",
          "layout": { "column": 1, "row": 4, "width": 4, "height": 3 },
          "visualization": { "id": "viz.area" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "legend": { "enabled": true },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT count(*) FROM ServerMetric WHERE appName = 'stream-recognizer' AND measurement = 'StreamRecognizerProviderCall' FACET provider TIMESERIES AUTO LIMIT 20"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Transport / local failure rate (%)",
          "layout": { "column": 5, "row": 4, "width": 4, "height": 3 },
          "visualization": { "id": "viz.bar" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT percentage(count(*), WHERE success = 0) AS 'Fail %' FROM ServerMetric WHERE appName = 'stream-recognizer' AND measurement = 'StreamRecognizerProviderCall' FACET provider SINCE 6 hours ago LIMIT 20"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Shazam: outcomes by reason (1h)",
          "layout": { "column": 9, "row": 4, "width": 4, "height": 3 },
          "visualization": { "id": "viz.pie" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT count(*) FROM ServerMetric WHERE appName = 'stream-recognizer' AND measurement = 'StreamRecognizerProviderCall' AND provider = 'shazam' FACET reason SINCE 1 hour ago LIMIT 20"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        },
        {
          "title": "Match rate by station (%)",
          "layout": { "column": 1, "row": 7, "width": 12, "height": 3 },
          "visualization": { "id": "viz.bar" },
          "rawConfiguration": {
            "facet": { "showOtherSeries": false },
            "nrqlQueries": [
              {
                "accountId": 0,
                "query": "SELECT percentage(count(*), WHERE matched = 1) AS 'Match %' FROM ServerMetric WHERE appName = 'stream-recognizer' AND measurement = 'StreamRecognizerProviderCall' AND provider = 'shazam' FACET stationID SINCE 6 hours ago LIMIT 50"
              }
            ],
            "platformOptions": { "ignoreTimeRange": false }
          }
        }
      ]
    }
  ]
}
