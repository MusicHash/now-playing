{
  "name": "now-playing-server",
  "version": "1.0.0",
  "description": "Now Playing backend server",
  "main": "src/now_playing.js",
  "type": "module",
  "scripts": {
    "test": "NODE_ENV=development node --experimental-vm-modules --env-file ../.env ../node_modules/jest/bin/jest.js",
    "start": "NODE_ENV=production NODE_OPTIONS='--experimental-loader newrelic/esm-loader.mjs -r newrelic --experimental-specifier-resolution=node' node --env-file ../.env ./src/now_playing.js",
    "debug": "NODE_ENV=development PINO_LOG_LEVEL=debug NODE_OPTIONS='--experimental-loader newrelic/esm-loader.mjs -r newrelic --experimental-specifier-resolution=node' node --env-file ../.env ./src/now_playing.js",
    "nr:diag": "NODE_OPTIONS='--experimental-loader newrelic/esm-loader.mjs -r newrelic --experimental-specifier-resolution=node' node --env-file ../.env scripts/nr_diag.mjs",
    "coverage": "NODE_ENV=development ../node_modules/jest/bin/jest.js --env-file ../.env --collect-coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MusicHash/now-playing.git"
  },
  "author": "MusicHash",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MusicHash/now-playing/issues"
  },
  "homepage": "https://github.com/MusicHash/now-playing#readme",
  "dependencies": {
    "@sentry/node": "^10.53.1",
    "audd.io": "^3.0.2",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "lru-cache": "^11.3.6",
    "m3u8stream": "^0.8.6",
    "mysql2": "^3.22.3",
    "newrelic": "^13.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "recd-cli": "^1.2.0",
    "scrapa": "^0.3.3",
    "spotify-web-api-node": "^5.0.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.5",
    "babel-jest": "^30.4.1",
    "eslint": "^10.3.0",
    "jest": "^30.4.2",
    "nock": "^14.0.15",
    "sinon": "^22.0.0",
    "ts-jest": "^29.4.9"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.(js)$": "babel-jest"
    },
    "moduleDirectories": [
      "<rootDir>/src",
      "node_modules"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/tests/fixtures/"
    ],
    "moduleFileExtensions": [
      "js",
      "json"
    ],
    "verbose": false
  }
}
